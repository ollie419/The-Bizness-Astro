---
import BaseLayout from '../layouts/BaseLayout.astro';
import { client } from '../lib/sanity.js';
import imageUrlBuilder from '@sanity/image-url';

const stories = await client.fetch(`*[_type == "story"] | order(_createdAt desc) {
  name,
  discipline,
  tag,
  blurb,
  slug,
  portrait
}`);

const builder = imageUrlBuilder(client);
function urlFor(source) {
  return builder.image(source).url();
}
const splitLast = (t = '') => {
  const k = t.trim().lastIndexOf(' ');
  return k === -1 ? [t.trim()] : [t.slice(0, k).trim(), t.slice(k + 1)];
};
---

<BaseLayout title="The Bizness">
  <main class="home">
    <div class="grid">
      {stories.map((story) => (
        <a href={`/story/${story.slug.current}`}>
          <article class="card" data-tag={story.tag}>
            <div class="card-img">
              {story.portrait && (
                <img src={urlFor(story.portrait)} alt={story.name} />
              )}
            </div>
            <div class="card-label">
              <div class="card-name">{splitLast(story.name).map((line) => <span class="card-line">{line}</span>)}</div>
              <div class="card-discipline">{splitLast(story.discipline).map((line) => <span class="card-line">{line}</span>)}</div>
            </div>
            <div class="card-bar">
              <p class="card-blurb">{story.blurb}</p>
            </div>
          </article>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>